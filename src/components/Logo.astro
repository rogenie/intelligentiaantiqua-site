---
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---
<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect x="1.5" y="1.5" width="61" height="61" fill="#241e18" stroke="#e2c39a" stroke-width="1.5" />
  <rect x="5" y="5" width="54" height="54" fill="none" stroke="#c4a574" stroke-width="0.6" />
  <path d="M8 16 H56" stroke="#c4a574" stroke-width="1" />
  <path d="M18 26 L32 16 L46 26" fill="none" stroke="#e2c39a" stroke-width="1.6" />
  <text
    x="32"
    y="46"
    text-anchor="middle"
    fill="#f4efe6"
    font-family="Palatino, Georgia, serif"
    font-size="18"
    font-weight="700"
  >IA</text>
</svg>
