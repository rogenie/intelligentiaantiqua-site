---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildGraph } from '../lib/schema';
import { site } from '../data/site';
import { formatDate } from '../lib/format';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Refunds', href: '/refunds/' },
];
const updated = new Date(`${site.policiesUpdated}T00:00:00.000Z`);
const description = 'A Family AI Safety Kit pre-order can be refunded in full anytime before it ships. Ask through the contact page.';
---
<Base title={`Refunds · ${site.name}`} description={description} graph={buildGraph({ crumbs })}>
  <Breadcrumbs items={crumbs} />
  <header class="page-header">
    <p class="kicker">Orders</p>
    <h1>Refunds</h1>
    <p class="lede">A Family AI Safety Kit pre-order can be refunded in full anytime before it ships.</p>
    <p class="meta">Updated <time datetime={site.policiesUpdated}>{formatDate(updated)}</time></p>
  </header>
  <div class="prose">
    <h2 id="before-it-ships">Before it ships</h2>
    <p>
      You can have a full refund anytime before the order ships. The <a href="/safety-kit/">Family AI Safety Kit</a> page says pre-orders ship within 4-6 weeks.
    </p>
    <h2 id="how-to-ask">How to ask</h2>
    <p>
      Email <a href={`mailto:${site.email}`}>{site.email}</a> from the <a href="/contact/#orders">contact page</a>. Include the name and email used at checkout.
      If the mailbox is not open yet, the owner of the site is still creating it. The address is the one this project will use.
      Do not send passwords, account numbers, medical details, or copies of an identity document.
    </p>
    <p>
      This page is about the physical kit and the refund. It is general education, not professional advice. The kit helps a family agree on a plan to verify calls and messages. The <a href="/articles/ai-scams-voice-clones-and-deepfakes/">voice-clone guide</a> is the free method. The cards are a convenience.
    </p>
  </div>
</Base>
