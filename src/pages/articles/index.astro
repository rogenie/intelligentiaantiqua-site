---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { pillars } from '../../data/pillars';
import { site } from '../../data/site';
import { buildGraph } from '../../lib/schema';
import { formatDate } from '../../lib/format';

const articles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Guides', href: '/articles/' },
];
const description = 'Every finished Intelligentia Antiqua guide, with the date we last checked it.';
---
<Base title={`Guides · ${site.name}`} description={description} graph={buildGraph({ crumbs })}>
  <Breadcrumbs items={crumbs} />
  <header class="page-header">
    <p class="kicker">Library</p>
    <h1>Guides</h1>
    <p class="lede">Finished pages only. A topic with no guide yet says so on its hub. We do not stuff the shelf to look busy.</p>
  </header>
  <div class="card-grid">
    {articles.map((article) => (
      <article class="card">
        <p class="kicker">{pillars.find((item) => item.id === article.data.pillar)?.title}</p>
        <h2><a href={`/articles/${article.data.slug}/`}>{article.data.title}</a></h2>
        <p>{article.data.description}</p>
        <p class="meta">Updated {formatDate(article.data.updatedDate)}</p>
      </article>
    ))}
  </div>
</Base>
